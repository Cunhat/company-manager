{
  "name": "company-manager",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/node": "^26.2.0",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "better-auth": "1.7.1",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web --",
    "db:push": "turbo run db:push -F @company-manager/db --",
    "db:studio": "turbo run db:studio -F @company-manager/db --",
    "db:generate": "turbo run db:generate -F @company-manager/db --",
    "db:migrate": "turbo run db:migrate -F @company-manager/db --",
    "deploy": "turbo run deploy -F @company-manager/infra --",
    "destroy": "turbo run destroy -F @company-manager/infra --",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@company-manager/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "@company-manager/config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.0"
}
